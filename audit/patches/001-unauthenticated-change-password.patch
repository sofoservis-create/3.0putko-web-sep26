+    const user =
+      req.auth.kind === "host"
+        ? await Host.findById(callerId)
+        : await User.findById(callerId);
 
     if (!user) {
       return res.status(404).json({ message: "User not found" });
     }
 
+    // Knowing the current password is what proves this is the account holder and
