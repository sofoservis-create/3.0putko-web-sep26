+//
+// An allowlist, from the environment so staging and production differ without a
+// code change.
+const allowedOrigins = (
+  process.env.CORS_ALLOWED_ORIGINS ||
+  "https://www.putko.sk,https://putko.sk"
+)
+  .split(",")
+  .map((o) => o.trim())
+  .filter(Boolean);
+
